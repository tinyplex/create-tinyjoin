import './todoInput.css';
import {createButton} from './button';
import {createInput} from './input';
import {createError, clearError, showError} from './error';
import type {Todos} from './todos';

export const createTodoInput = (todos: Todos): HTMLFormElement => {
  const container = document.createElement('form');
  container.id = 'todoInput';

  const input = createInput('What needs to be done?');
  const addButton = createButton('Add', null, 'primary', 'submit');
  const error = createError();
  let pending = false;

  const addTodo = async () => {
    const text = input.value.trim();
    if (!text || pending) {
      return;
    }
    pending = true;
    input.disabled = true;
    addButton.disabled = true;
    clearError(error);
    try {
      await todos.add(text);
      input.value = '';
    } catch (failure) {
      showError(error, failure, 'Could not add this todo.');
    } finally {
      pending = false;
      input.disabled = false;
      addButton.disabled = false;
      input.focus();
    }
  };

  container.addEventListener('submit', (event) => {
    event.preventDefault();
    void addTodo();
  });

  container.append(input, addButton, error);

  return container;
};
