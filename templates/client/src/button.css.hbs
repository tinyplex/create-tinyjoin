button {
  padding: 0.5rem 1rem;
  border: 1px solid #666;
  border-radius: 0.25rem;
  background: #222;
  color: #fff;
  font-family: inherit;
  font-weight: 800;
  cursor: pointer;
  margin: 0.5rem;
}

button:hover {
  border-color: #7c3aed;
}

button:disabled {
  cursor: wait;
  opacity: 0.6;
}

button.primary {
  background: #7c3aed;
  border: none;
  padding: 0.75rem 1.5rem;
}

button.primary:hover {
  background: #6d28d9;
}
