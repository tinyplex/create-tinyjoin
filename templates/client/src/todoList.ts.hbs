import './todoList.css';
import {createTodoItem} from './todoItem';
import {createError, clearError, showError} from './error';
import type {Todos} from './todos';

export const createTodoList = (todos: Todos): HTMLDivElement => {
  const container = document.createElement('div');
  const error = createError();
  const list = document.createElement('div');
  list.id = 'todoList';
  container.append(error, list);
  let pending = false;
  let mutationFailed = false;
  let renderGeneration = 0;

  const setDisabled = (disabled: boolean) => {
    list.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button')
      .forEach((control) => { control.disabled = disabled; });
  };

  const mutate = async (
    operation: () => Promise<unknown>,
    restore?: () => void,
  ) => {
    if (pending) {
      return;
    }
    pending = true;
    mutationFailed = false;
    setDisabled(true);
    clearError(error);
    try {
      await operation();
    } catch (failure) {
      restore?.();
      mutationFailed = true;
      showError(error, failure, 'Could not save this change.');
    } finally {
      // Refresh reads only: a rejected write may already have committed.
      await render();
      pending = false;
      setDisabled(false);
    }
  };

  const render = async () => {
    const generation = ++renderGeneration;
    try {
      const rows = await todos.read();
      if (generation !== renderGeneration) {
        return;
      }
      if (!mutationFailed) {
        clearError(error);
      }

      const items = rows.map((todo) => createTodoItem(
        todo.id,
        todo.text,
        todo.completed,
        (checkbox) => {
          void mutate(
            () => todos.setCompleted(todo.id, !todo.completed),
            () => { checkbox.checked = todo.completed; },
          );
        },
        () => {
          void mutate(() => todos.remove(todo.id));
        },
      ));
      list.replaceChildren(...items);
      setDisabled(pending);
    } catch (failure) {
      if (generation === renderGeneration && !mutationFailed) {
        showError(error, failure, 'Could not refresh your todos. Reload to try again.');
      }
    }
  };

  todos.subscribe(() => void render());
  void render();

  return container;
};
