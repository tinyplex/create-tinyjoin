:root {
  color: #20251f;
  background: #f4f6f1;
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  min-width: 20rem;
  min-height: 100vh;
  margin: 0;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

main {
  width: min(36rem, calc(100% - 2rem));
  margin: 0 auto;
  padding: 5rem 0 3rem;
}

header {
  margin-bottom: 2rem;
}

.eyebrow {
  margin: 0 0 0.5rem;
  color: #397253;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3rem, 12vw, 5rem);
  line-height: 0.95;
}

.intro {
  margin: 1rem 0 0;
  color: #697066;
}

form {
  padding: 1rem;
  border: 1px solid #d7ddd3;
  border-radius: 1rem;
  background: #fff;
  box-shadow: 0 1rem 3rem rgb(32 49 38 / 8%);
}

form label {
  display: block;
  margin-bottom: 0.65rem;
  font-size: 0.85rem;
  font-weight: 750;
}

.composer {
  display: flex;
  gap: 0.6rem;
}

.composer input {
  min-width: 0;
  flex: 1;
  padding: 0.8rem 0.9rem;
  border: 1px solid #cbd3c7;
  border-radius: 0.7rem;
  color: inherit;
  background: #fbfcfa;
}

.composer input:focus {
  border-color: #397253;
  outline: 3px solid rgb(57 114 83 / 15%);
}

.composer button,
.delete {
  border: 0;
  border-radius: 0.7rem;
  font-weight: 750;
}

.composer button {
  padding: 0.8rem 1.15rem;
  color: #fff;
  background: #397253;
}

.status,
.error {
  min-height: 1.4rem;
  margin: 1rem 0 0.5rem;
  color: #697066;
  font-size: 0.85rem;
}

.error {
  color: #a0382e;
}

ul {
  display: grid;
  gap: 0.65rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.todo,
.empty {
  border: 1px solid #d7ddd3;
  border-radius: 0.85rem;
  background: #fff;
}

.todo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.8rem 0.9rem;
}

.todo label {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 0.75rem;
}

.todo input {
  width: 1.15rem;
  height: 1.15rem;
  accent-color: #397253;
}

.todo span {
  overflow-wrap: anywhere;
}

.todo.is-done span {
  color: #8a9088;
  text-decoration: line-through;
}

.delete {
  padding: 0.45rem 0.65rem;
  color: #7b423c;
  background: #f7ecea;
}

.empty {
  padding: 2rem;
  color: #7b8278;
  text-align: center;
}

footer {
  margin-top: 2rem;
  color: #7b8278;
  font-size: 0.82rem;
  text-align: center;
}

a {
  color: #397253;
}

@media (max-width: 32rem) {
  main {
    padding-top: 2.5rem;
  }

  .composer {
    align-items: stretch;
    flex-direction: column;
  }
}
