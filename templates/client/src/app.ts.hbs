{{!-- The chosen queries decide which template becomes the todos module. --}}
{{#if drizzle}}
{{includeFile template="client/src/todos.drizzle.ts.hbs" output="src/todos.{{ext}}"}}
{{else if kysely}}
{{includeFile template="client/src/todos.kysely.ts.hbs" output="src/todos.{{ext}}"}}
{{else}}
{{includeFile template="client/src/todos.sql.ts.hbs" output="src/todos.{{ext}}"}}
{{/if}}
import {databaseReady} from './database';
import {createTodos} from './todos';
import {createTopBar} from './topBar';
import {showLoading, hideLoading} from './loading';
import {createTodoInput} from './todoInput';
import {createTodoList} from './todoList';
import {createButton} from './button';
import {createError, showError} from './error';

export const app = async (root: HTMLElement) => {
  const appElement = document.createElement('div');
  appElement.id = 'app';
  root.replaceChildren(createTopBar(), appElement);

  // Show loading spinner
  const loadingDiv = showLoading(appElement);

  try {
    const todos = createTodos(await databaseReady);
    const todoInputContainer = createTodoInput(todos);
    appElement.appendChild(todoInputContainer);

    const input = todoInputContainer.querySelector('input')!;
    input.focus();

    appElement.appendChild(createTodoList(todos));
  } catch (error) {
    const message = createError();
    message.id = 'startupError';
    showError(message, error, 'Could not open your todos.');
    appElement.append(
      message,
      createButton('Retry', () => location.reload(), 'primary'),
    );
  } finally {
    hideLoading(loadingDiv);
  }
};
