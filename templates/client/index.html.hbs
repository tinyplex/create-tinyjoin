<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>TinyJoin Todos</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      user-select: none;
      margin: 0;
      padding: 0;
      font-family: system-ui, sans-serif;
    }

    #root {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    #app {
      max-width: 60rem;
      width: 100%;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    body {
      --hue: 270;
      --fg: oklch(85% 0.01 var(--hue));
      --fg2: oklch(60% 0.01 var(--hue));
      --bg: oklch(20% 0.01 var(--hue));
      --bg2: oklch(25% 0.01 var(--hue));
      --border: oklch(30% 0.01 var(--hue));
      --bg-header: oklch(30% 0.008 var(--hue) / 0.5);
      --accent: #7c3aed;
      color: var(--fg);
      background: var(--bg);
    }
  </style>
</head>

<body>
  <div id="root"></div>
  <script type="module" src="/src/index.{{ext}}"></script>
</body>

</html>
