-- Disposable public demo data for the generated TinyGres starter.
-- This is intentionally anonymous and read-only. Do not copy this policy to
-- private application data without designing the appropriate authorization.

do $table$
declare
  existing_table regclass := to_regclass('public.tinygres_posts');
begin
  if existing_table is null then
    create table public.tinygres_posts (
      id bigint primary key,
      title text not null,
      published boolean not null default false
    );
    comment on table public.tinygres_posts is
      'create-tinygres:v1 disposable public demo table';
  elsif obj_description(existing_table, 'pg_class') is distinct from
    'create-tinygres:v1 disposable public demo table'
  then
    raise exception using
      message = 'public.tinygres_posts already exists and is not owned by create-tinygres',
      hint = 'Rename the existing table or edit this starter to use a different demo table.';
  end if;
end
$table$;

insert into public.tinygres_posts (id, title, published)
values
  (1, 'Snapshot rows arrive from Supabase', true),
  (2, 'Queries run locally in TinyGres', true),
  (3, 'Drafts remain filtered locally', false)
on conflict (id) do update
set
  title = excluded.title,
  published = excluded.published;

grant usage on schema public to anon;
grant select on table public.tinygres_posts to anon;

alter table public.tinygres_posts enable row level security;

do $policy$
begin
  if not exists (
    select 1
    from pg_policies
    where schemaname = 'public'
      and tablename = 'tinygres_posts'
      and policyname = 'tinygres_posts_anon_read'
  ) then
    create policy tinygres_posts_anon_read
      on public.tinygres_posts
      for select
      to anon
      using (true);
  end if;
end
$policy$;

alter table public.tinygres_posts replica identity full;

do $publication$
begin
  if not exists (
    select 1 from pg_publication where pubname = 'supabase_realtime'
  ) then
    create publication supabase_realtime;
    comment on publication supabase_realtime is
      'create-tinygres:v1 disposable demo publication';
  end if;

  if not exists (
    select 1
    from pg_publication_tables
    where pubname = 'supabase_realtime'
      and schemaname = 'public'
      and tablename = 'tinygres_posts'
  ) then
    alter publication supabase_realtime add table public.tinygres_posts;
  end if;
end
$publication$;
