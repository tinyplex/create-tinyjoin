  "src/button.ts": "import './button.css';

export const createButton = (
  text: string,
  onClick: (() => void) | null,
  variant: 'default' | 'primary' = 'default',
  type: 'button' | 'submit' = 'button',
): HTMLButtonElement => {
  const button = document.createElement('button');
  button.textContent = text;
  button.type = type;
  if (variant === 'primary') {
    button.className = 'primary';
  }
  if (onClick) {
    button.addEventListener('click', onClick);
  }
  return button;
};
",
  "src/database.ts": "import {create, ClientError, type Client} from 'tinyjoin';

export type TodoRow = {
  id: string;
  text: string;
  completed: boolean;
  created: number;
};

export type TodosDatabase = Client;

export const DATA_DIR = 'memory://';

export const createTodosDatabase = async (): Promise<TodosDatabase> => {
  const database = await create(DATA_DIR);

  try {
    // Create the table, and add the starter todos, only on the first visit.
    if (!(await hasTodosTable(database))) {
      await database.exec(\`
        CREATE TABLE IF NOT EXISTS todos (
          id TEXT PRIMARY KEY,
          text TEXT NOT NULL,
          completed BOOLEAN NOT NULL DEFAULT false,
          created INTEGER NOT NULL DEFAULT 0
        )
      \`);
      await database.query(
        \`INSERT INTO todos (id, text, completed, created)
         VALUES ($1, $2, $3, $4), ($5, $6, $7, $8)\`,
        ['1', 'Learn TinyJoin', false, 1, '2', 'Build an app', false, 2],
      );
    }

    return database;
  } catch (error) {
    await database.close().catch(() => undefined);
    throw error;
  }
};

const hasTodosTable = async (database: TodosDatabase): Promise<boolean> => {
  try {
    await database.query('SELECT id FROM todos LIMIT 1');
    return true;
  } catch (error) {
    if (error instanceof ClientError && error.code === 'TABLE_NOT_FOUND') {
      return false;
    }
    throw error;
  }
};

export const databaseReady = createTodosDatabase();
// Startup can reject before the page's load event. app() presents the failure.
void databaseReady.catch(() => undefined);

addEventListener(
  'pagehide',
  () =>
    void databaseReady
      .then((database) => database.close())
      .catch(() => undefined),
  {once: true},
);

// A restored page must not reuse the client closed during pagehide.
addEventListener('pageshow', (event) => {
  if (event.persisted) {
    location.reload();
  }
});
",
  "src/error.css": ".error {
  color: #fca5a5;
  line-height: 1.5;
  margin: 0 0 1rem;
  user-select: text;
}
",
  "src/error.ts": "import {ClientError} from 'tinyjoin';
import './error.css';

export const createError = (): HTMLParagraphElement => {
  const element = document.createElement('p');
  element.className = 'error';
  element.setAttribute('role', 'alert');
  element.hidden = true;
  return element;
};

export const clearError = (element: HTMLElement): void => {
  element.hidden = true;
  element.textContent = '';
};

export const showError = (
  element: HTMLElement,
  error: unknown,
  fallback: string,
): void => {
  let message =
    error instanceof Error ? \`\${fallback} \${error.message}\` : fallback;
  if (error instanceof ClientError) {
    if (error.code === 'STORAGE_LOCKED') {
      message =
        'This app is already open in another tab. Close the other tab, then select Retry.';
    } else if (
      [
        'RECOVERY_REQUIRED',
        'STORAGE_COMMIT_OUTCOME_UNKNOWN',
        'STORAGE_ENGINE_POISONED',
        'WORKER_ERROR',
        'WORKER_MESSAGE_ERROR',
        'WORKER_TERMINATED',
      ].includes(error.code)
    ) {
      message =
        'The change may have been saved. Reload this page and check your todos before trying again.';
    }
  }
  element.textContent = message;
  element.hidden = false;
};
",
  "src/index.ts": "import {app} from './app';

const root = document.getElementById('root')!;

addEventListener('load', () => {
  void app(root);
});
",
