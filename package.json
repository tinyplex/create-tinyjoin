{
  "name": "create-tinyjoin",
  "version": "0.0.7",
  "author": "jamesgpearce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyplex/create-tinyjoin.git"
  },
  "homepage": "https://tinyjoin.org",
  "bugs": {
    "url": "https://github.com/tinyplex/create-tinyjoin/issues"
  },
  "license": "MIT",
  "description": "Scaffold a standalone TinyJoin browser database application.",
  "keywords": [
    "postgresql",
    "local-first",
    "webassembly",
    "web-worker",
    "app generator",
    "scaffolding"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "create-tinyjoin": "./cli.js"
  },
  "scripts": {
    "build": "node build.js",
    "local": "node scripts/local.mjs",
    "local:source": "node scripts/local-source.mjs",
    "spell": "cspell --no-progress \"*.{md,json,js,mjs,ts}\" \"src/**\" \"test/**\" \"templates/**\" \"scripts/**\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run test/cli.test.ts",
    "test:generated": "npm run build && vitest run test/generated-app.test.ts",
    "test:e2e": "npm run test:generated && playwright test",
    "prePublishPackage": "npm i && npm run spell && npm run typecheck && npm test && npm run test:e2e",
    "publishPackage": "npm run prePublishPackage && npm publish ./dist"
  },
  "dependencies": {
    "tinycreate": "^1.0.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "cspell": "^10.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
